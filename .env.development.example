# Šablóna pre LOKÁLNY vývoj proti `npx supabase start` (Docker). Skopíruj
# tento súbor do `.env.local`:
#
#   cp .env.development.example .env.local
#
# `.env.local` je gitignorovaný a NIKDY sa necommituje — aj keď sú hodnoty
# nižšie verejné demo hodnoty, `.env.local` môže neskôr obsahovať aj tvoje
# vlastné, produkčné tajomstvá, takže zostáva pravidlo bezvýnimočné.
#
# Pre produkčné nasadenie proti cloudovému/self-hosted Supabase projektu
# použi namiesto tohto `.env.example` a postupuj podľa `docs/INSTALL.md`.
# Podrobný návod k lokálnemu vývoju je v `docs/DEVELOPMENT.md`.

# ==============================================================================
# ZNAČKA — neutrálna, presne to, čo treba na screenshoty do nápovede
# ==============================================================================
NEXT_PUBLIC_BRAND_NAME="Demo firma"
NEXT_PUBLIC_BRAND_SHORT_NAME="Demo firma"
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_BRAND_APP_NAME=Dochádzka
NEXT_PUBLIC_BRAND_LOGO=

# ==============================================================================
# SUPABASE (lokálny stack)
# ==============================================================================
# Kľúče nižšie NEVYPĹŇAJ ručne — vypíše ti ich `npx supabase status` po
# `npx supabase start`. Sú fixné a rovnaké na každom stroji, ktorý beží proti
# lokálnemu Supabase stacku, takže to nie sú tajomstvá — doslovne ich tu
# neuvádzame len preto, že skenery tajomstiev na GitHube blokujú ich formát.
#
#   npx supabase status
#
# Skopíruj hodnoty "publishable key" a "secret key" na riadky nižšie.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ==============================================================================
# DATABÁZA (lokálny stack, port 54322)
# ==============================================================================
# Appka pripája do Postgresu pod DVOMA rôznymi rolami — zámerne, viď
# docs/ARCHITECTURE.md, "Model bezpečnosti":

# Vlastník schémy (Supabase rola "postgres", rolbypassrls=true). Lokálny
# stack ju zakladá sám, s pevným heslom "postgres" — bezpečné len preto, že
# port 54322 počúva výhradne na localhoste. LEN pre migrácie
# (`npm run db:migrate`), `npm run setup` a úzky zoznam výnimiek v kóde.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Rola "app_user" (NOSUPERUSER, NOBYPASSRLS) — appka pod ňou beží pri bežnej
# prevádzke, RLS politiky sa na ňu reálne vzťahujú. Heslo nižšie je zámerne
# triviálne — databáza je dostupná len z localhostu, nie je čo chrániť.
# Nastavuje ho `node scripts/setup-app-role-password.mjs` (súčasť
# `npm run dev:bootstrap`, spúšťa sa PRED prvým štartom appky).
APP_DATABASE_URL=postgresql://app_user:dev_local_only@127.0.0.1:54322/postgres
APP_DB_PASSWORD=dev_local_only

# ==============================================================================
# APLIKÁCIA
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# EMAIL (Resend)
# ==============================================================================
# Zámerne PRÁZDNE pre lokálny vývoj. Bez RESEND_API_KEY appka maily
# NEODOŠLE, len ich obsah (vrátane pozývacieho/reset odkazu a
# email-OTP kódu pre 2FA ownera) VYPÍŠE do terminálu, kde beží
# `npm run dev` (`lib/email/resend.ts`, `[email:stub]`) — flow je funkčný
# end-to-end, len bez reálneho doručenia. Toto NIE JE to isté, čo lokálny
# Mailpit (nižšie v docs/DEVELOPMENT.md) — appka posiela maily VLASTNou
# cestou cez Resend, nie cez Supabase Auth natívne, takže do Mailpitu sa
# tieto maily nedostanú. Sleduj preto terminál, nie Mailpit.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ==============================================================================
# TAJOMSTVÁ
# ==============================================================================
# ⚠️⚠️⚠️ POZOR: hodnoty nižšie sú VEREJNÉ (z tohto súboru v repozitári) —
# platia LEN pre lokálny vývojový stack. V PRODUKCII SA NESMÚ POUŽIŤ NIKDY —
# vygeneruj si tam nové, vlastné hodnoty podľa `.env.example`.

# Presne 32 bajtov po dekódovaní z base64 (overené priamo v kóde,
# lib/punch/qr-token.ts) — appka pri štarte s inou dĺžkou zlyhá.
QR_TOKEN_SECRET=JRUWPYpX2b7fk44Ya70Wriu8zgDw236Z72jg1pTh5/M=

# Presne 32 bajtov po dekódovaní z base64 (overené priamo v kóde,
# lib/punch/hmac.ts) — appka pri štarte s inou dĺžkou zlyhá.
TERMINAL_SECRET_ENCRYPTION_KEY=VtUn9fliP5kTR4BHiN6meRldTYv1kxQ36h+C874Mqzo=

# Formát nie je pevný (len sa porovnáva ako reťazec) — bežný hex reťazec.
CRON_SECRET=477185d8a11d268722b9e140f36c6c57e1e636c11bc68ead

# ==============================================================================
# LEN PRE VÝVOJ — toto sa do produkcie NESMIE dostať
# ==============================================================================

# Heslo pre 5 fiktívnych dev kont (owner/2× manager/2× employee), ktoré
# `npm run db:seed` (volané aj z `npm run dev:bootstrap`) založí SAMO, ak je
# táto premenná nastavená — bez nej sa demo dáta založia, ale žiadne z kont
# sa nedá prihlásiť (nemá heslo). Rovnaké heslo pre všetkých päť, len pre
# lokálny vývoj, nie zámerne "silné" — pozri lib/db/dev-accounts.ts.
DEV_ACCOUNTS_PASSWORD=Dev-Local-Only-2026!

# Pri bežnom lokálnom vývoji necháva ZÁMERNE ZAKOMENTOVANÉ — 2FA ownera
# zostáva zapnuté a email-OTP kód si vyzdvihneš z terminálu (viď sekciu
# EMAIL vyššie), lebo tak sa testuje SKUTOČNÝ tok, akým appka beží aj v
# produkcii. Odkomentuj len vtedy, keď ti prihlasovanie cez 2FA prekáža pri
# nesúvisiacej práci — tvrdo ignorované, keď NODE_ENV=production.
# DEV_DISABLE_2FA=true

# Názov a IČO demo organizácie, ktorú založí `npm run db:seed`. Zámerne
# ponechané na predvolené hodnoty appky ("Demo firma" / "00000000") — sedia
# s NEXT_PUBLIC_BRAND_NAME vyššie.
# SEED_ORG_NAME=
# SEED_ORG_ICO=