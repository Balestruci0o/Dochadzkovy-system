# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
!.env.example
!.env.development.example

# interné dokumenty — nikdy nezverejňovať
/_archiv-neverejne/

# lokálna konfigurácia AI coding asistenta (per-vývojár, nezdieľaná)

# lokálny Supabase stack — dočasné súbory (config.toml SA commituje)
supabase/.temp/
supabase/.branches/

# Playwright (scripts/screenshots/) — výstupy behu, NIE samotné screenshoty
# (public/help/screenshots/*.png a docs/screenshots/*.png SA commitujú)
/test-results/
/playwright-report/
/blob-report/
scripts/screenshots/.auth/
