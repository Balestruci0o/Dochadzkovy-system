# Skopíruj tento súbor do `.env.local` a vyplň hodnoty. `.env.local` nikdy
# nekomituj do gitu (je v .gitignore) — obsahuje produkčné tajomstvá.

# ==============================================================================
# ZNAČKA
# ==============================================================================
# Všetko v tejto sekcii je VOLITEĽNÉ — bez vyplnenia appka beží pod neutrálnym
# názvom "Dochádzka". Detaily a ďalšie vrstvy (logo, farby) viď BRANDING.md.
#
# POZOR: NEXT_PUBLIC_* premenné Next.js dosadzuje PRI BUILDE, nie za behu —
# po zmene hodnoty treba spustiť `npm run build` nanovo, reštart servera
# nestačí.

# Plný názov firmy — zobrazuje sa napr. na prihlasovacej stránke.
NEXT_PUBLIC_BRAND_NAME=

# Krátky názov — použije sa napr. v názve PWA pri pridaní na plochu.
NEXT_PUBLIC_BRAND_SHORT_NAME=

# Podnadpis pod menom appky v bočnom paneli. Prázdne = v UI sa nezobrazí.
NEXT_PUBLIC_BRAND_TAGLINE=

# Názov appky samotnej (odlišné od názvu firmy, ak appku chceš pomenovať inak).
NEXT_PUBLIC_BRAND_APP_NAME=

# Cesta k logu. Default "/branding/logo.svg" — logo sa dá vymeniť aj bez tejto
# premennej, jednoducho prepísaním súboru public/branding/logo.svg.
NEXT_PUBLIC_BRAND_LOGO=

# ==============================================================================
# SUPABASE
# ==============================================================================
# Tri kľúče z nastavení Supabase projektu (Project Settings → API). Postup
# založenia projektu je v docs/INSTALL.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ==============================================================================
# DATABÁZA
# ==============================================================================
# Appka pripája do Postgresu pod DVOMA rôznymi rolami — zámerne, viď
# docs/ARCHITECTURE.md, "Model bezpečnosti":

# Vlastník schémy (Supabase rola "postgres", rolbypassrls=true). Používa sa
# LEN pre migrácie (`npm run db:migrate`), seed dát a úzky zoznam výnimiek
# v kóde, kde RLS fyzicky nedá použiť. Appka pod touto rolou BEŽAŤ NESMIE —
# RLS by sa nikdy nevyhodnotilo.
DATABASE_URL=

# Rola "app_user" (NOSUPERUSER, NOBYPASSRLS), pod ktorou beží appka pri
# bežnej prevádzke — RLS politiky sa na ňu reálne vzťahujú. Heslo pre túto
# rolu nastavuje `scripts/setup-app-role-password.mjs` (spusti ho PRED prvým
# štartom appky, viď docs/INSTALL.md).
APP_DATABASE_URL=

# Heslo pre rolu "app_user" — použije ho `scripts/setup-app-role-password.mjs`
# na `ALTER ROLE app_user WITH PASSWORD ...`. Musí zodpovedať heslu v
# APP_DATABASE_URL vyššie.
APP_DB_PASSWORD=

# ==============================================================================
# APLIKÁCIA
# ==============================================================================

# Verejná URL adresa nasadenia appky, BEZ lomítka na konci (napr.
# https://dochadzka.vasafirma.sk). Používa sa na zostavenie odkazov v mailoch
# (pozvánka, reset hesla).
NEXT_PUBLIC_APP_URL=

# ==============================================================================
# EMAIL (Resend)
# ==============================================================================
# Bez RESEND_API_KEY sa maily NEODOŠLÚ, len sa vypíšu do server konzoly —
# appka nespadne, len nedôjde ku skutočnému doručeniu. Vhodné pre lokálny
# vývoj bez nastaveného Resend účtu.

RESEND_API_KEY=

# Odosielateľ v tvare "Meno <email@doména>". Doména MUSÍ byť overená v
# Resend (Resend inak odoslanie odmietne) — preto sa neodvodzuje automaticky
# z názvu firmy vyššie. Bez tejto premennej sa použije
# "<NEXT_PUBLIC_BRAND_NAME> <onboarding@resend.dev>" (funguje len na
# testovacie odosielanie, nie pre skutočnú prevádzku).
EMAIL_FROM=

# Voliteľná adresa pre Reply-To. Bez nej Resend hlavičku Reply-To vôbec
# nepošle a bežné mailové klienty odpovedajú priamo na EMAIL_FROM.
EMAIL_REPLY_TO=

# ==============================================================================
# TAJOMSTVÁ
# ==============================================================================
# Vygeneruj NOVÉ hodnoty pre KAŽDÚ inštaláciu — nikdy sa neprepoužívajú medzi
# rôznymi nasadeniami (napr. produkcia a testovacie/staging prostredie).

# Podpisový kľúč pre JWT rotujúceho QR kódu (pípanie). Musí byť PRESNE
# 32 bajtov po dekódovaní z base64, inak appka pri štarte zlyhá.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QR_TOKEN_SECRET=

# Šifrovací kľúč (AES-256-GCM) pre tajomstvá terminálov uložené v DB. Musí
# byť PRESNE 32 bajtov po dekódovaní z base64, inak appka pri štarte zlyhá.
# POZOR: zmena tejto hodnoty za behu znefunkční VŠETKY existujúce terminály
# (ich uložené tajomstvo sa už nedá dešifrovať) — treba ich znova zaregistrovať.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TERMINAL_SECRET_ENCRYPTION_KEY=

# Zdieľané tajomstvo pre cron endpointy (/api/cron/*) — volajúci musí poslať
# hlavičku "Authorization: Bearer <CRON_SECRET>". Formát nie je pevný (len sa
# porovnáva ako reťazec), stačí bežný hex reťazec:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# ==============================================================================
# LEN PRE VÝVOJ — toto sa do produkcie NESMIE dostať
# ==============================================================================

# Heslo pre 5 fiktívnych dev kont (owner/manager/employee), ktoré založí
# `npm run db:seed:accounts`. Bez tejto premennej skript odmietne bežať.
# DEV_ACCOUNTS_PASSWORD=

# "true" vypne vynucovanie 2FA pri prihlásení pre pohodlnejší lokálny vývoj.
# Tvrdo ignorované, keď NODE_ENV=production, bez ohľadu na hodnotu.
# DEV_DISABLE_2FA=

# Názov a IČO demo organizácie, ktorú založí `npm run db:seed`. Bez nastavenia
# sa použije "Demo firma" / "00000000".
# SEED_ORG_NAME=
# SEED_ORG_ICO=
