{
  "name": "dochadzka",
  "version": "1.0.0",
  "description": "Dochádzkový a rozvrhový systém pre firmy s viacerými prevádzkami.",
  "license": "AGPL-3.0-or-later",
  "author": "Balestruci0o (https://github.com/Balestruci0o)",
  "repository": "git+https://github.com/Balestruci0o/Dochadzkovy-system.git",
  "homepage": "https://github.com/Balestruci0o/Dochadzkovy-system",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local lib/db/seed.ts",
    "db:seed:accounts": "tsx --env-file=.env.local lib/db/seed-dev-accounts.ts",
    "dev:accounts-photo": "tsx --env-file=.env.local scripts/dev-accounts-photo.ts",
    "screenshots": "tsx --env-file=.env.local scripts/screenshots/index.ts",
    "setup": "tsx --env-file=.env.local scripts/setup.ts",
    "dev:bootstrap": "tsx scripts/dev-bootstrap.ts",
    "dev:stop": "npx supabase stop",
    "dev:status": "npx supabase status",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.db.test.{ts,tsx}'",
    "test:db": "vitest run .db.test."
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "next": "15.5.20",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "resend": "^6.17.2",
    "roboto-fontface": "^0.10.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "pdfjs-dist": "^6.1.200",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
